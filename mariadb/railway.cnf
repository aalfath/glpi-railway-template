[mariadbd]
# Data lives in a subfolder of the Railway volume, so the volume's lost+found never shows up as a database.
datadir = /var/lib/mysql/data
skip-name-resolve
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
# Small-plan memory sizing (Railway Free plan: 0.5 GB per service).
innodb_buffer_pool_size = 128M
innodb_log_buffer_size = 8M
key_buffer_size = 8M
performance_schema = OFF
max_connections = 60
